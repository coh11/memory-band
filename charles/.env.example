# Charles's version reads the ONE .env at the repo root (the same file Mamoune's version uses).
# Add the lines you need to that file. Never commit it.
#
# Optional: speech path (the passive features don't need it)
DEEPGRAM_API_KEY=
# Optional: smarter sentence tagging (Gemini first, then OpenAI, else offline keywords)
GEMINI_API_KEY=
OPENAI_API_KEY=
# The number on your band's bag
BAND_NUMBER=
# Optional: ntfy topics. Default: random hard-to-guess names, shown on the dashboard
NTFY_USER_TOPIC=
NTFY_FAMILY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional: a secret the phone Shortcut adds to /api/leaving?token=...
MEMORY_TOKEN=
# NTFY_DRY_RUN=1          print notifications instead of sending
# MEMORY_TAGGER=keywords  force the offline tagger (most predictable for a demo)
# GEMINI_MODEL=gemini-2.5-flash
